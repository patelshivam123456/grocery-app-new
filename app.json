{
  "expo": {
    "name": "Just Harvst",
    "slug": "just-harvst",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/just-harvst-app-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/just-harvst-adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.shivam_1003.justharvst"
    },
    "extra": {
      "eas": {
        "projectId": "6449cdbb-7ffc-4544-a92c-39a317f7ee2e"
      }
    },
    "owner": "shivam_onecorp2",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FBF5",
          "imageWidth": 200,
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Just Harvst to use your microphone to search for groceries by voice.",
          "speechRecognitionPermission": "Allow Just Harvst to recognize product and category names you speak."
        }
      ]
    ]
  }
}
